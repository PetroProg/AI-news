# ==========================================
# Personal AI News Aggregator - Configuration
# ==========================================

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database (PostgreSQL)
POSTGRES_DB=news_db
POSTGRES_USER=news_user
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Ollama Local LLM Settings
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Telegram Client API (Telethon)
TELEGRAM_API_ID=api_id
TELEGRAM_API_HASH=api_hash
TELEGRAM_SESSION_NAME=name

# Telegram Bot API (aiogram 3.x)
TELEGRAM_BOT_TOKEN=token
TELEGRAM_ADMIN_CHAT_ID=id

# Remote Workstation (Wake-on-LAN)
WOL_MAC_ADDRESS=address
WOL_BROADCAST_IP=ip

# AdGuard Home DNS Shield
ADGUARD_URL=http://news_ai_adguard:3000
ADGUARD_USER=admin
ADGUARD_PASSWORD=changeme_local

# Beszel Hub & Agent (Monitoring)
BESZEL_URL=http://172.18.0.1:8090
BESZEL_EMAIL=admin@example.local
BESZEL_PASSWORD=changeme_local
BESZEL_AGENT_KEY=ssh-ed25519_changeme_local
