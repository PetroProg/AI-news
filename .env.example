# ==========================================
# Personal AI News Aggregator - Configuration
# ==========================================

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database (PostgreSQL)
POSTGRES_DB=news_db
POSTGRES_USER=news_user
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Ollama Local LLM Settings
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Telegram Client API (Telethon)
TELEGRAM_API_ID=api_id
TELEGRAM_API_HASH=api_hash
TELEGRAM_SESSION_NAME=name

# Telegram Bot API (aiogram 3.x)
TELEGRAM_BOT_TOKEN=token
TELEGRAM_ADMIN_CHAT_ID=id

# Remote Workstation (Wake-on-LAN)
WOL_MAC_ADDRESS=address
WOL_BROADCAST_IP=ip